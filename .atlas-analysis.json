  "keyFeatures": [
    "White-label reporting for agencies",
    "Connect to 30+ marketing data integrations (Google Ads, Facebook, etc.)",
    "Drag-and-drop report and dashboard builder",
    "Scheduled automated report delivery via email or PDF",
    "Custom domain and branding for client-facing reports",
    "Team collaboration with role-based access",
    "Reusable templates and themes for report design",
    "Custom metrics and calculated formulas",
    "Media and asset library for report design",
    "Public shareable report links for clients"
